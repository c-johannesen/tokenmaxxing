{
  "name": "tokenmaxxing",
  "version": "1.5.0",
  "packageManager": "bun@1.4.2",
  "private": true,
  "description": "A tiny pixel town for people who run AI coding agents, with a macOS menu bar app that syncs your token usage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HansKristoffer/tokenmaxxing"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "token-usage",
    "leaderboard",
    "menu-bar",
    "pixel-art",
    "multiplayer",
    "rivet",
    "bun"
  ],
  "type": "module",
  "workspaces": [
    "core",
    "server",
    "web",
    "site",
    "app/helper"
  ],
  "scripts": {
    "dev": "bun run site:build && RIVETKIT_STORAGE_PATH=.data/rivet RIVET_LOG_LEVEL=error bun --watch server/src/main.ts",
    "dev:seed": "bun server/scripts/dev-seed.ts",
    "desktop:dev": "cd app/desktop && tauri dev",
    "desktop:build": "cd app/desktop && tauri build",
    "helper:once": "bun app/helper/src/main.ts --once",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc -p core && tsc -p server && tsc -p web && tsc -p app/helper",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "vendor:pricing": "bun server/scripts/vendor-pricing.ts",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
